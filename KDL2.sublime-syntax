%YAML 1.2
---
name: KDL2
file_extensions: [kdl2]
scope: text.kdl.2
first_line_match: '/-[[:blank:]]*kdl-version[[:blank:]]+2[[:blank:]]*$'
version: 2

# bat 0.25 uses syntect 5.2, which cannot run the full Sublime grammar reliably.
# The preserved full grammar is in KDL2.sublime-syntax.source.

variables:
  bare: '[^\s\/\\(){};\[\]=#"]+'
  property: '{{bare}}(?=[[:blank:]]*=)'
  number: '[+-]?(?:(?:0x[0-9a-fA-F][0-9a-fA-F_]*)|(?:0o[0-7][0-7_]*)|(?:0b[01][01_]*)|(?:[0-9][0-9_]*(?:\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?))'
  keyword: '#(?:true|false|null|inf|-inf|nan)'

contexts:
  main:
    - include: whitespace
    - include: comments
    - include: node
    - match: '}'
      scope: invalid.illegal.stray-brace.kdl punctuation.section.mapping.end.kdl
    - match: '\S'
      scope: invalid.illegal.unexpected.kdl

  node:
    - match: '{{bare}}'
      scope: entity.name.tag.node.kdl
      push: node-tail
    - include: quoted-node

  node-tail:
    - meta_scope: meta.node.kdl
    - include: whitespace-inline
    - include: block-comment
    - match: '//.*(?=\n|$)'
      scope: comment.line.double-slash.kdl
      pop: 1
    - match: ';'
      scope: punctuation.terminator.node.kdl
      pop: 1
    - match: '\r?\n'
      pop: 1
    - match: '{'
      scope: punctuation.section.mapping.begin.kdl
      set: child-block
    - match: '{{property}}'
      scope: meta.property.name.kdl meta.mapping.key.kdl entity.other.attribute-name.kdl
    - match: '='
      scope: keyword.operator.assignment.kdl punctuation.separator.key-value.kdl
    - include: values
    - match: '\S'
      scope: invalid.illegal.unexpected.kdl

  child-block:
    - meta_scope: meta.block.child.kdl
    - include: whitespace
    - include: comments
    - match: '}'
      scope: punctuation.section.mapping.end.kdl
      pop: 1
    - include: node
    - match: '\S'
      scope: invalid.illegal.unexpected.kdl

  values:
    - match: '(?<raw_hash>#+)"[^\r\n]*?"\k<raw_hash>'
      scope: meta.argument.value.kdl meta.mapping.value.kdl meta.string.kdl string.quoted.double.raw.kdl
    - match: '"(?:\\(?:["\\\/bfnrt]|u\{[0-9a-fA-F]{1,6}\})|[^"\\\r\n])*"'
      scope: meta.argument.value.kdl meta.mapping.value.kdl meta.string.kdl string.quoted.double.kdl
    - match: '\({{bare}}\)'
      scope: meta.annotation.kdl entity.name.type.kdl
    - match: '{{keyword}}'
      scope: meta.argument.value.kdl meta.mapping.value.kdl keyword.other.kdl constant.language.kdl
    - match: '{{number}}'
      scope: meta.argument.value.kdl meta.mapping.value.kdl constant.numeric.value.kdl
    - match: '{{bare}}'
      scope: meta.argument.value.kdl meta.mapping.value.kdl string.unquoted.kdl

  quoted-node:
    - match: '"(?:\\(?:["\\\/bfnrt]|u\{[0-9a-fA-F]{1,6}\})|[^"\\\r\n])*"'
      scope: entity.name.tag.node.kdl meta.string.kdl string.quoted.double.kdl
      push: node-tail
    - match: '(?<raw_node_hash>#+)"[^\r\n]*?"\k<raw_node_hash>'
      scope: entity.name.tag.node.kdl meta.string.kdl string.quoted.double.raw.kdl
      push: node-tail

  comments:
    - match: '//.*(?=\n|$)'
      scope: comment.line.double-slash.kdl
    - include: block-comment
    - match: '/-'
      scope: comment.line.slash-dash.kdl punctuation.definition.comment.begin.kdl

  block-comment:
    - match: '/\*'
      scope: punctuation.definition.comment.begin.kdl
      push: block-comment-body

  block-comment-body:
    - meta_scope: comment.block.kdl
    - match: '\*/'
      scope: punctuation.definition.comment.end.kdl
      pop: 1
    - include: block-comment

  whitespace:
    - match: '[[:blank:]\r\n]+'
      scope: whitespace.kdl

  whitespace-inline:
    - match: '[[:blank:]]+'
      scope: whitespace.kdl
